node_modules/
dist/
build/
# 例外：桌面端的打包资源（图标）必须进版本库，否则 CI 打包找不到图标
!/desktop/build/
# 例外里的例外：Go 二进制由 scripts/build-desktop-backend.mjs 现场构建
/desktop/build/backend/
.pnpm-store/
.cache/
*.log
.DS_Store
.env
.env.*
!.env.example
tmp/

# Go
/chat-deepseek
/chat-deepseek.exe
/data/
*.test
coverage.out

# Embedded UI build output (the .gitkeep keeps go:embed happy)
!/internal/webui/dist/
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Release staging (CI assembles artifacts here)
/release/
/*.spec

# Android：工程在 android/，不提交 Gradle wrapper（CI 用 setup-gradle 固定 8.10.2）
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
# Go 交叉编译产物由 :app:buildGoArm64 现场生成，不进版本库
/android/app/src/main/jniLibs/
# mobile Web 构建产物（只进 APK assets，浏览器包仍是 dist/），不提交
/dist-mobile/

# 本地 Android SDK（sdkmanager 装在这里，不进版本库）
/.android-sdk/
